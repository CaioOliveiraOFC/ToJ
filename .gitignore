# Ambiente virtual
.venv/
venv/

# Variáveis de ambiente (NUNCA commitar chaves de API)
.env
.env.*
.env*

# Cache do Python
__pycache__*
*.py[cod]
*.pyo
*.pyd
.ruff_cache/

# Dados gerados
savegame.json
saves/
reports/*
# Exceto a evidência CITADA: um relatório que ninguém consegue abrir não é
# evidência de nada. A lista é nominal de propósito — curinga aqui faria toda
# execução do simulador aparecer no `git status`.
!reports/BASELINE_PRE_BALANCE.md
!reports/baseline_pre_balance_agregados.json
!reports/baseline_pre_balance_completo.txt
# Os três relatórios da Copa Arena de Testes 01 (`tools/arena_copa_teste.py`).
!reports/pvp/
reports/pvp/*
!reports/pvp/copa_teste_01.md
!reports/pvp/copa_teste_01_final_detalhada.md
!reports/pvp/copa_teste_01_trace.json
# A Copa Arena 02 (`tools/arena_copa_02.py`): relatórios, calibração e visual.
!reports/pvp/copa_02/
reports/pvp/copa_02/*
!reports/pvp/copa_02/relatorio.md
!reports/pvp/copa_02/final_detalhada.md
!reports/pvp/copa_02/final_trace.json
!reports/pvp/copa_02/dashboard.html
!reports/pvp/copa_02/relatorio_visual.pdf
!reports/pvp/copa_02/calibracao.json

